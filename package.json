{
  "name": "mechanical-design-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "以《机械设计》（第十版）为知识框架的开放学习笔记",
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1",
    "build": "vitepress build docs",
    "postbuild": "node scripts/validate-build.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "dev:theory": "vitepress dev theory/docs --host 127.0.0.1",
    "build:theory": "vitepress build theory/docs",
    "preview:theory": "vitepress preview theory/docs --host 127.0.0.1",
    "feishu": "node tools/feishu-sync.mjs && node tools/feishu-merge.mjs",
    "feishu:merge": "node tools/feishu-merge.mjs",
    "feishu:latex": "node tools/feishu-sync.mjs --latex && node tools/feishu-merge.mjs --latex",
    "feishu:upload": "bash tools/feishu-upload-latex.sh",
    "feishu:setup": "bash tools/feishu-setup.sh",
    "test": "node --test tests/*.test.mjs && npm run figures:check",
    "figures:generate": "node scripts/generate-figures.mjs && node scripts/export-existing-figures.mjs",
    "figures:check": "node scripts/generate-figures.mjs --check && node scripts/export-existing-figures.mjs --check"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "1.6.4",
    "vue": "^3.5.44"
  },
  "dependencies": {
    "katex": "^0.19.1"
  }
}
